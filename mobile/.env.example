# URL of the trusted machine hosting the Slates Next.js server.
#
# Physical phone: use the host's LAN address, not localhost. Both devices must
# be on the same network, and the portal must run with `npm run dev:mobile`.
# Example: http://192.168.1.42:3000
#
# iOS Simulator can use http://localhost:3000.
# Android Emulator can use http://10.0.2.2:3000.
SLATES_MOBILE_SERVER_URL=http://192.168.1.42:3000
