# URL of the machine hosting the Slates portal.
#
# Recommended: the host's Tailscale Serve address (see docs/remote-host-setup.md),
# e.g. https://gaming-pc.tail1234.ts.net — HTTPS, works away from home, and only
# devices on your tailnet can reach it. Install Tailscale on the phone too.
#
# Same-Wi-Fi alternative: the host's LAN address while it runs
# `npm run dev:mobile`, e.g. http://192.168.1.42:7528. Anyone on that network
# can then use the portal, which has no login.
#
# iOS Simulator can use http://localhost:7528.
# Android Emulator can use http://10.0.2.2:7528.
SLATES_MOBILE_SERVER_URL=https://gaming-pc.tail1234.ts.net
