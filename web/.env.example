# ── Schoology ──────────────────────────────────────────────────────────────
#
# The one pair of values Slates genuinely needs: everything on the board, the
# gradebook and the calendar is read with these.
#
# Generate them while signed in to Schoology, at
#   https://<your-district>.schoology.com/api
# and paste both here. They act as your own account and never leave this
# machine — Slates talks to api.schoology.com directly from its own server.
#
# If that page says API access is disabled, your district has turned it off
# and only an administrator can turn it back on.
SCHOOLOGY_KEY=
SCHOOLOGY_SECRET=

# ── AI features (all optional) ─────────────────────────────────────────────

# OpenAI — powers the GPT models in the Tutor view (/api/tutor).
# Without this the GPT models return an empty stream and the UI shows
# "Empty response from tutor." Everything else in the app works fine.
OPENAI_API_KEY=

# The Claude models in the Tutor view need no key here — they run through
# the local Claude Code CLI (ai-sdk-provider-claude-code), so run this once
# on whatever machine hosts the portal:
#   npm install -g @anthropic-ai/claude-code && claude auth login
# That login covers every request; picking a Claude model without it just
# fails that one request, the other models keep working.

# Grok and Composer also need no key here — they run through @cursor/sdk,
# which has its own one-time browser login (separate from `cursor-agent
# login`, mints a 90-day key at ~/.cursor/sdk/auth.json). Run once:
#   npm run cursor:login
# That login covers every request to those two models only.

# OpenRouter — powers DeepSeek, GLM (Z.ai), Qwen, and Gemini in the Tutor view.
# Without this those models return an empty stream, same as a missing
# OPENAI_API_KEY. Get a key at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# Optional. Defaults to gpt-5.6. Drop to gpt-5.4-mini for a cheaper, faster tutor.
SLATES_TUTOR_MODEL=

# Optional. Model used to estimate every open assignment after each sync.
# Defaults to gpt-5.4-mini. This must be a real model ID accepted by OpenAI.
SLATES_ESTIMATE_MODEL=

# The Slates extension's ID, from chrome://extensions after loading it unpacked.
# Without this the portal stays in sample-data mode and never tries to sync.
NEXT_PUBLIC_SLATES_EXTENSION_ID=

# Optional. Powers the live, interactive Desmos graphs the tutor can draw —
# on request, folded into a study guide, or attached to a quiz question. Get a
# free key at https://www.desmos.com/api/v1.11/docs/index.html. Without it,
# a graph reply falls back to printing the plain expressions.
NEXT_PUBLIC_DESMOS_API_KEY=

# Optional. Narrates the tutor's generated teaching videos and draws the
# illustrations it can produce on request. Without it, a video or image
# request fails — get a key at https://elevenlabs.io.
ELEVENLABS_API_KEY=

# ---------------------------------------------------------------------------
# Counselor
# ---------------------------------------------------------------------------

# The counselor — the second option on the launcher — runs on OPENAI_API_KEY
# above, the same key the tutor uses. Without it the counselor answers with
# "No OPENAI_API_KEY set" and the voice call refuses to connect. The same key
# also embeds the counseling library:
#
#   npm run counselor:ingest -- ~/path/to/your/guides
#
# That reads a folder of counseling material (PDF, Word, slides, spreadsheets,
# Markdown) and writes a searchable index to ~/.slates/knowledge/. Without one
# the counselor still works, but answers "how do I…" questions from its own
# general knowledge rather than from your guides — the Profile screen says
# which is happening.

# Optional. The model behind the typed counselor. Defaults to gpt-5.6-sol.
SLATES_COUNSELOR_MODEL=

# Optional. The realtime model behind the voice counselor. Defaults to
# gpt-realtime-2.1-mini. Voice runs peer-to-peer from the browser straight to
# OpenAI over WebRTC; Slates only mints the one-call ephemeral key, so the
# audio never passes through this app.
SLATES_COUNSELOR_VOICE_MODEL=

# Optional. Which voice it speaks in. Defaults to cedar.
SLATES_COUNSELOR_VOICE=

# Optional. Third-party AI detectors for the essay studio's AI check.
#
# The check works without these: it measures the prose itself — rhythm,
# concrete detail, contractions, the vocabulary models overuse — locally, with
# no network call and no draft leaving this machine. Setting a key blends that
# service's score in at 40%.
#
# Only services with a real API are supported, and nothing is sent anywhere
# unless you set a key. Slates does not scrape detector websites: they have no
# public API, they break constantly, and a student's unpublished personal
# statement should not be posted to a company that never agreed to receive it.
SLATES_GPTZERO_API_KEY=
SLATES_SAPLING_API_KEY=
