# dependencies
node_modules/

# next
web/.next/
web/out/
web/*.tsbuildinfo
web/next-env.d.ts

# env / secrets
.env
.env.local
.env.*.local

# desktop package
desktop/dist/

# agent / local junk — except the skills the tutor loads, which are part of
# the app rather than local scratch. Ignoring `.claude/*` instead of `.claude/`
# is deliberate: git won't descend into an ignored directory, so a negation
# under a wholly-ignored path never matches.
.claude/*
!.claude/skills/
.playwright-mcp/
.playwright-cli/
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# generated artifacts — lesson video renders and whatever a tutor skill wrote.
# Both are outputs of running the app, not inputs to building it, and they run
# to hundreds of megabytes within a few sessions.
output/
videos/
desktop/*.log

# stray screenshots
/profile-after-upload.png
/sidebar-*.png
mobile/.env
mobile/node_modules/
!mobile/.env.example
